{
  "info": {
    "_postman_id": "d6676f8f-cc68-4697-9d8c-f2d21dddf6c8",
    "name": "Pastline API (local)",
    "description": "Pastline REST API для локальної перевірки. Порядок: Health → Auth/Register → Auth/Login → решта.\n\nCSRF обробляє скрипт колекції: перед кожним POST/PUT/DELETE він бере свіжий токен з GET /auth/csrf і ставить заголовок X-XSRF-TOKEN. Cookie сесії (JSESSIONID) і XSRF-TOKEN Postman зберігає сам.\n\nПотрібно: docker compose up -d, Ollama з embeddinggemma і qwen3:4b-instruct, бекенд на 8090. Документація: docs/api.md, docs/features/*.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "postman-password"
    },
    {
      "key": "entryId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Змінним запитам потрібен CSRF-токен: беремо свіжий (після входу він змінюється) і кладемо в заголовок.",
          "if (pm.request.method !== 'GET') {",
          "  pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/api/v1/auth/csrf', (err, res) => {",
          "    if (err) { console.error('CSRF:', err); return; }",
          "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: res.json().token });",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
