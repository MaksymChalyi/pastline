# Шаблон локальних налаштувань. Копія: .env (Git її ігнорує).
# Для локальної роботи файл не потрібен: нижче значення за замовчуванням.
# .env читають docker compose і бекенд (spring.config.import у application.properties).
# Секрети онлайн-демо (Neon, Gemini) сюди не кладуться: вони лише в змінних середовища Render.

# PostgreSQL у Docker (compose.yaml) і підключення бекенду до нього.
# Користувач і пароль застосовуються лише до нового тому даних (docker compose down -v).
PASTLINE_DB_PORT=5434
PASTLINE_DB_USER=pastline
PASTLINE_DB_PASSWORD=pastline

# Порт бекенду
PASTLINE_PORT=8090

# Адреса Ollama
OLLAMA_URL=http://localhost:11434
